{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "open-learner-dict/0.10.0/gloss.schema.json",
  "title": "open-learner-dict gloss (one object per JSONL line)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "word": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "gloss"
      ]
    },
    "zipf": {
      "type": "number"
    },
    "zipf_source": {
      "enum": [
        "wordfreq",
        "level-estimate",
        "coca-estimate"
      ]
    },
    "senses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sense_id": {
            "type": "string"
          },
          "pos": {
            "enum": [
              "n.",
              "v.",
              "adj.",
              "adv.",
              "prep.",
              "conj.",
              "pron.",
              "det.",
              "int.",
              "num.",
              "aux.",
              "abbr."
            ]
          },
          "zh": {
            "type": "string"
          },
          "zh_hant": {
            "type": "string"
          },
          "register": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(formal|informal|slang|dated|literary|uk|us|offensive-mild|offensive-strong|domain:.+)$"
            }
          }
        },
        "required": [
          "sense_id",
          "pos",
          "zh",
          "zh_hant",
          "register"
        ],
        "additionalProperties": false
      }
    },
    "kid_safe": {
      "type": "boolean"
    },
    "confidence": {
      "enum": [
        "low",
        "medium"
      ]
    },
    "reviewed": {
      "type": "boolean"
    },
    "meta": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "word",
    "layer",
    "zipf",
    "zipf_source",
    "senses",
    "kid_safe",
    "confidence",
    "reviewed",
    "meta"
  ],
  "additionalProperties": false
}
